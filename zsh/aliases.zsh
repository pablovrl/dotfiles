# git
alias gsw='git switch'
alias gst='git stash'
alias gstp='git stash pop'
alias gmsq='git merge --squash'
alias gpr='git pull --rebase'
alias gp='git pull'

# zsh
alias zshconf='code ~/.zshrc'

# file utilities
