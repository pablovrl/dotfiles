# git
alias gsw='git switch'
alias gcp='git cherry-pick'
alias gst='git stash'
alias gstp='git stash pop'
alias gmsq='git merge --squash'
alias gpr='git pull --rebase'
alias gp='git pull'
alias gpus='git push'
alias gpulr='git pull --rebase'
alias gpul='git pull'
alias gundo='git reset --soft HEAD~1'

# zsh
alias zshconf='code ~/.zshrc'

# file utilities
alias ls='eza'
alias lsl='eza -l'
alias lsa='eza -a'
alias lsla='eza -la'
alias lst='eza --tree'
alias cat='bat'
